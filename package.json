{
  "name": "eco-pantas-integrated",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "ECO PANTAS — Petualangan Ksatria Anjuk Ladang, empat pengalaman belajar terintegrasi",
  "scripts": {
    "build": "npm run build:css && npm run check && npm test",
    "build:css": "npx @tailwindcss/cli -i ./css/tailwind.input.css -o ./css/tailwind.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./css/tailwind.input.css -o ./css/tailwind.css --watch",
    "test": "node --test tests/*.test.mjs",
    "check": "node tests/project-audit.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
